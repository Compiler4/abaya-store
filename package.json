        "brace-expansion": "5.0.9",
        "framer-motion": "^12.43.0",
        "jsonwebtoken": "^9.0.3",
        "jspdf": "^4.2.1",
        "lucide-react": "^1.30.0",
        "next": "16.3.0",
        "nodemailer": "9.0.5",
        "postcss": "8.5.23",
        "prisma": "5.22.0",
        "react": "19.2.4",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "19.2.4",
        "react-hot-toast": "^2.6.0",
        "react-icons": "^5.6.0",
