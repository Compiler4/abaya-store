{
    "name": "rify-abaya-store",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=20.9.0"
    },
    "scripts": {
        "predev": "prisma generate",
        "dev": "next dev",
        "dev:fresh": "node scripts/clean-next.mjs && prisma generate && next dev",
        "build": "node scripts/hostinger-build.mjs",
        "start": "next start",
        "postinstall": "prisma generate",
        "lint": "eslint",
