        "@types/node": "^20.19.39",
        "@types/nodemailer": "^8.0.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.3.0",
        "tailwindcss": "^4",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "brace-expansion": "5.0.9",
        "esbuild": "0.28.2",
        "minimatch": "10.2.6",
